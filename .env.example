# Copy to .env (gitignored) and fill in. Never commit real values.
# Hub + clients read these; every platform uses the same names.

# Required everywhere (format user:secret).
CHISEL_AUTH=spider:CHANGE_ME

# Clients only: which hub to dial.
HUB_URL=https://spider-chisel.onrender.com

# Hub listen port. Render injects its own; Docker/Compose default 8080;
# HF Spaces shim defaults to 7860.
PORT=8080

# Localhost-only status UI behind chisel --backend.
BACKEND_PORT=7861

# Status UI: auto (gradio if installed else stdlib) | gradio | basic | none.
FIEF_UI=auto

# Optional: enables the sshd sidecar (key-only, localhost-only,
# reachable over the tunnel on SSH_PORT). Works as root (serves SSH_USER)
# and non-root (serves the container user, e.g. `user` on HF).
# SSH_PUBKEY=ssh-ed25519 AAAAC3...
# SSH_PORT=2222
# SSH_USER=fief

# Consumer forwards (fief forward). Defaults: 1080 / 1081 / 2222.
# LOCAL_PORT=1080
# EGRESS_PORT=1081

# Tailnet (fief tail up, hub sidecar). All optional except the auth key.
# Cloud nodes (ephemeral disks!) MUST use an Ephemeral reusable tagged key
# from the admin console — there is no --ephemeral flag on `tailscale up`,
# ephemerality comes from the key. Pi (persistent disk) can use a stable key.
# TAILSCALE_AUTHKEY=tskey-auth-CHANGE_ME
# TAIL_HOSTNAME=fief-node
# TAIL_PROXY=                  # empty = direct; else socks5h://127.0.0.1:1081
# TAIL_SERVE=                  # hub serve forwards, e.g. 1080,1081
# TAIL_ADVERTISE_EXIT=0        # 1 = offer this node as exit node
# TAIL_ROUTES=                 # e.g. 192.168.1.0/24 (needs admin approval)
# TAILSCALE_VERSION=1.102.4
