# Topology / non-secret defaults. Secrets come from the one place:
# config/secrets.yaml (encrypted) — on hosts run
#   fief config export --node <pi|laptop> > .env
# instead of filling this in by hand. Never commit real values.
# Hub + clients read the same names on every platform.
#
# Every name in fief.config.KNOWN_VARS must appear here (set or
# commented) — tests/test_ssot.py enforces it.

# Clients only: which hub to dial (optional: defaults to nodes.toml hf space_id).
# HUB_URL=https://<owner>-<space>.hf.space

# Hub listen port. Render injects its own; Docker/Compose default 8080;
# HF Spaces shim defaults to 7860.
PORT=8080

# Localhost-only status UI behind chisel --backend.
BACKEND_PORT=7861

# Status UI: auto (gradio if installed else stdlib) | gradio | basic | none.
FIEF_UI=auto

# Chisel pin + keepalive (defaults live in fief.config; set to override).
# CHISEL_AUTH='user:...'           # required everywhere; use secrets.yaml
# CHISEL_KEEPALIVE=25s
# CHISEL_VERSION=1.12.0

# Optional: enables the sshd sidecar (key-only, localhost-only,
# reachable over the tunnel on SSH_PORT). Works as root (serves SSH_USER);
# HF image has no sshd binary (use tailnet SSH there instead).
# SSH_PUBKEY=ssh-ed25519 AAAAC3...
# SSH_PORT=2222
# SSH_USER=fief

# Consumer forwards (fief forward). Defaults: 1080 / 1081 / 2222.
# LOCAL_PORT=1080
# EGRESS_PORT=1081
# EXIT_SOCKS=socks                # exit node: reverse-SOCKS name on the hub

# Skip the sshd forward without the --no-ssh flag.
# FIEF_NO_SSH=0

# Set to 1 to disable auto-loading gitignored .env files (env + sops only).
# FIEF_NO_DOTENV=0

# Override cache locations (binaries, box artifacts, ssh keys, mesh run dir).
# FIEF_BIN_DIR=
# FIEF_BOX_DIR=
# FIEF_SSH_DIR=
# FIEF_RUN_DIR=

# Space identity for the public-URL line in status (HF injects SPACE_ID).
# SPACE_ID=<owner>/<name>

# Mesh (fief mesh up, hub sidecar). All optional except the mesh key.
# Cloud nodes (ephemeral disks!) MUST use an Ephemeral reusable tagged key
# from the admin console. Pi (persistent disk) can use a stable key.
# FIEF_MESH_KEY=tskey-auth-CHANGE_ME
# FIEF_MESH_HOSTNAME=fief-node
# FIEF_MESH_PROXY=                  # empty = direct; else socks5h://127.0.0.1:1081
# FIEF_MESH_SERVE=                  # hub serve forwards, e.g. 1080,1081
# FIEF_MESH_ADVERTISE_EXIT=0        # 1 = offer this node as exit node
# FIEF_MESH_ROUTES=                 # e.g. 192.168.1.0/24 (needs admin approval)
# FIEF_MESH_ACCEPT_DNS=0            # 1 = let the mesh own node DNS
# FIEF_MESH_SSH=0                   # 1 = accept tailnet SSH (needs console ACL)
# FIEF_MESH_EXTRA_ARGS=             # passthrough, e.g. extra up flags
# FIEF_MESH_VERSION=1.102.4
# FIEF_MESH_PROXY_PORT=1055         # local proxy listener for restricted nets
# FIEF_MESH_VERBOSE=0               # 1 = full daemon log passthrough (debug)
# FIEF_MESH_SYSTEM=0                # 1 = drive the system daemon (reuse login)
# FIEF_MESH_SOCKET=                 # system socket override (default /var/run/tailscale/tailscaled.sock)
